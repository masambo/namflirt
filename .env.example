VITE_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOYMENT=dev:your-deployment
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
VITE_SITE_URL=https://app.namflirt.com

# Configure these as Convex deployment environment variables, never as VITE_*:
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=namflirt. <notifications@your-verified-domain.com>
# NAMFLIRT_APP_URL=https://app.namflirt.com

# Set this in the Convex dashboard for each deployment, not in client code:
# CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-frontend-api.clerk.accounts.dev
# ADMIN_EMAILS=admin@example.com,second-admin@example.com
# ADMIN_USER_IDS=user_abc123,user_def456
